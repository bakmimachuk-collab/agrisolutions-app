GEMINI_API_KEY=paste_your_private_key_here
# Optional: set this to a model available to your API key.
# GEMINI_MODEL=gemini-3.6-flash

# Public frontend configuration. Never put a Supabase service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only admin configuration. Never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPER_ADMIN_EMAIL=
